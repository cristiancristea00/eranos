# Rust
/target

# Coverage artefacts. `cargo llvm-cov --html` writes its report under
# target/llvm-cov; these are the raw profile data and lcov file a hand-run
# cargo llvm-cov writes elsewhere.
/lcov.info
*.profraw
*.profdata

# cargo-mutants writes its per-mutant logs, diffs, and outcome lists here.
/mutants.out
/mutants.out.old

# macOS
.DS_Store

# The Swift package's build products and what `cargo xtask` writes into it:
# the XCFramework of the library and the generated Swift, both built from
# the Rust sources, never committed.
/bindings/swift/.build/
/bindings/swift/EranosFFI.xcframework/
/bindings/swift/Sources/EranosGenerated/

# The Kotlin project's caches and build products, what `cargo xtask` writes
# into it (the generated Kotlin and the Android libraries, both built from
# the Rust sources), and the SDK path Android Studio writes for its machine;
# none is committed.
/bindings/kotlin/.gradle/
/bindings/kotlin/.kotlin/
/bindings/kotlin/**/build/
/bindings/kotlin/generated-android/src/main/jniLibs/
/bindings/kotlin/generated/src/
/bindings/kotlin/local.properties

# The Java project's caches and build products, and what `cargo xtask` writes
# into it: the generated Java, built from the Rust sources; none is
# committed.
/bindings/java/.gradle/
/bindings/java/build/
/bindings/java/src/generated/
