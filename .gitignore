# Rust
/target

# Coverage artefacts. `cargo llvm-cov --html` writes its report under
# target/llvm-cov; these are the raw profile data and lcov file a hand-run
# cargo llvm-cov writes elsewhere.
/lcov.info
*.profraw
*.profdata

# cargo-mutants writes its per-mutant logs, diffs, and outcome lists here.
/mutants.out
/mutants.out.old

# macOS
.DS_Store

# The Swift package's build products and what `cargo xtask` writes into it:
# the XCFramework of the library and the generated Swift, both built from
# the Rust sources, never committed.
/bindings/swift/.build/
/bindings/swift/EranosFFI.xcframework/
/bindings/swift/Sources/EranosGenerated/
/bindings/swift/examples/.build/

# The Kotlin project's caches and build products, what `cargo xtask` writes
# into it (the generated Kotlin and the Android libraries, both built from
# the Rust sources), and the SDK path Android Studio writes for its machine;
# none is committed.
/bindings/kotlin/.gradle/
/bindings/kotlin/.kotlin/
/bindings/kotlin/**/build/
/bindings/kotlin/generated-android/src/main/jniLibs/
/bindings/kotlin/generated/src/
/bindings/kotlin/local.properties

# The Java project's caches and build products, and what `cargo xtask` writes
# into it: the generated Java, built from the Rust sources; none is
# committed.
/bindings/java/.gradle/
/bindings/java/build/
/bindings/java/src/generated/

# The TypeScript package's installed dependencies, build products (the
# bundle, the declarations, and the documentation), and coverage report, and
# what `cargo xtask` writes into it: the generated TypeScript beside the
# WebAssembly module and wasm-bindgen's glue, all built from the Rust
# sources; none is committed.
/bindings/typescript/coverage/
/bindings/typescript/dist/
/bindings/typescript/node_modules/
/bindings/typescript/src/internal/

# The Kotlin Multiplatform project's caches and build products, where
# gobley's plugins write the generated Kotlin and the native libraries they
# build from the Rust sources, and the SDK path Android Studio writes for
# its machine; none is committed.
/bindings/kmp/.gradle/
/bindings/kmp/.kotlin/
/bindings/kmp/**/build/
/bindings/kmp/local.properties

# The C and C++ packages' build products (test programs, coverage data, and
# the documentation) and the headers Diplomat generates from the Rust sources,
# which `cargo xtask` writes beneath the hand-written ones; none is committed.
/bindings/c/build/
/bindings/c/generated/
/bindings/cpp/build/
/bindings/cpp/generated/

# The Python package's virtual environment, caches, coverage data, and
# documentation, and what `cargo xtask` writes into it: the generated Python
# module and a link to the library it loads, both built from the Rust
# sources; none is committed.
/bindings/python/.venv/
/bindings/python/.coverage
/bindings/python/.pytest_cache/
/bindings/python/.ruff_cache/
/bindings/python/build/
/bindings/python/src/eranos/_internal/eranos.py
/bindings/python/src/eranos/_internal/liberanos_uniffi.*
/bindings/python/**/__pycache__/
