{
    "version": "2.0.0",
    "tasks": [
        {
            // The commit gates, which AGENTS.md lists and `cargo xtask gates` runs.
            "label": "gates",
            "type": "shell",
            "command": "cargo xtask gates",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            // Coverage is a diagnostic, not a gate; doctests are not measured
            // on the stable toolchain. The two runs compile different
            // identifier generators, so the report merges both.
            "label": "coverage (html)",
            "type": "shell",
            "command": "cargo llvm-cov clean --workspace && cargo llvm-cov --no-report --workspace --all-features && cargo llvm-cov --no-report --workspace --no-default-features && cargo llvm-cov report --html --open",
            "problemMatcher": ["$rustc"]
        },
        {
            // The full criterion run whose numbers the settlement docs quote.
            // Timings are wall-clock: run it on an idle machine.
            "label": "bench",
            "type": "shell",
            "command": "cargo bench -p eranos",
            "problemMatcher": ["$rustc"]
        },
        {
            // One file per run: the whole crate takes hours.
            "label": "mutants (current file)",
            "type": "shell",
            "command": "cargo mutants --file ${relativeFile}",
            "problemMatcher": []
        }
    ]
}
