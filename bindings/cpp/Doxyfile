# The documentation of the C++ layer: every public declaration of eranos.hpp
# and its parts, with warnings as errors, so an undocumented declaration or
# parameter fails the build. The conversions and the generated classes of
# eranos::detail are left out.
PROJECT_NAME           = eranos
INPUT                  = include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
EXCLUDE                = include/eranos/detail
OUTPUT_DIRECTORY       = build/docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXCLUDE_SYMBOLS        = eranos::detail eranos::detail::*
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
