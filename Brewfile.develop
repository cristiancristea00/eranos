# What a developer's machine needs from Homebrew:
# `brew bundle --file Brewfile.develop`.
#
# Not here: rustup (install it from rustup.rs; it materialises
# rust-toolchain.toml, including the llvm-tools component coverage needs).

# The coverage report; the bottle is a download rather than a compile.
brew "cargo-llvm-cov"

# The mutation audit. No bottle exists, so it is compiled, which takes a few
# minutes.
cargo "cargo-mutants"

# --- The bindings -------------------------------------------------------------
# The Swift, Kotlin, Java, KMP, web, C, C++, and Python packages, their
# tests, and their formatters and linters. Xcode comes from the App Store.

# The JDK the Java package builds and tests with, and that Gradle, Kotlin,
# and the Android tools run on. Keg-only: JAVA_HOME points at it
# (docs/DEVELOPMENT.md § 1).
brew "openjdk@25"

# The JDK the Kotlin Multiplatform package's Gradle runs on. Its Gradle 9.0,
# the last on which the Android plugin that gobley supports builds without a
# deprecation warning, runs on JDKs 17 to 24, and 21 is the long-term release
# among them. Keg-only: JAVA_HOME_21 points at it (docs/DEVELOPMENT.md § 1).
brew "openjdk@21"

# The Node LTS the web package is tested on. Keg-only, so it sits beside
# any other Node.
brew "node@24"

# The clang that builds the C and C++ tests with the sanitizers, their
# clang-format and clang-tidy, and llvm-profdata and llvm-cov for their
# coverage, all of one LLVM release. Keg-only: LLVM_HOME points at it
# (docs/DEVELOPMENT.md § 1).
brew "llvm"

# The C and C++ layers' documentation.
brew "doxygen"

# The Python the Python package is tested on, the oldest it supports, which
# uv takes before a Python of its own (bindings/python/pyproject.toml), and
# uv, which installs the package's tools as its lock file pins them and runs
# them.
brew "python@3.14"
brew "uv"

# The Kotlin formatter.
brew "ktlint"

# The Swift linter, with the configuration in bindings/swift.
brew "swiftlint"

# The workflow linters and the dependency audit, as CI runs them.
brew "actionlint"
brew "zizmor"
brew "cargo-deny"

# The Android SDK command-line tools; their `sdkmanager` installs the NDK,
# the platform, and the build tools (docs/DEVELOPMENT.md § 1).
cask "android-commandlinetools"

# Builds the Android libraries with the NDK's linkers.
cargo "cargo-ndk", source: "https://github.com/bbqsrc/cargo-ndk?tag=v4.1.2"

# Generates the C and C++ headers. Pinned to the release of the `diplomat`
# crate the C bridge uses: a tool of another release reads the bridge
# differently.
cargo "diplomat-tool", source: "https://github.com/rust-diplomat/diplomat?tag=v0.16.1"

# Generates the web package's TypeScript and prepares its WebAssembly module.
# Pinned to the release of the player packages and of `uniffi-runtime-wasm`
# that the web crate links: a generator of another release writes code for
# another runtime. From its release tag, whose lock file `cargo install
# --locked` reads; the npm package of the same name ships none, and builds
# the tool on first use.
cargo "uniffi-bindgen-react-native", source: "https://github.com/jhugman/uniffi-bindgen-react-native?tag=0.31.0-5"
